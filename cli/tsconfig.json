{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src", "../shared/chat-protocol"],
  "exclude": ["node_modules", "dist"]
}
